{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "ddururiiiiiii",
          "project": "toffee-app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Toffee needs access to your photos so you can send photos and videos to your fans.",
          "cameraPermission": "Toffee needs camera access so you can take photos and videos for your fans.",
          "microphonePermission": "Toffee needs microphone access to record video with sound."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Toffee needs microphone access so you can send voice messages."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Toffee needs permission to save photos and videos you received to your library.",
          "photosPermission": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
