# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toffee?schema=public"

# 이 앱(단일 인스턴스)이 DB에 동시에 열 수 있는 커넥션 최대 개수. 비우면 10.
DB_POOL_MAX="10"

# Server
PORT=3000
NODE_ENV="development"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Google Sign-In — OAuth Client ID (idToken의 audience를 검증하는 데 씀)
GOOGLE_CLIENT_ID=""

# Apple Sign-In — App ID / bundle identifier
APPLE_CLIENT_ID=""

# LINE Login — Channel ID (id_token의 client_id 검증에 씀)
LINE_CHANNEL_ID=""

# 네이버/카카오는 자체 검증 가능한 idToken이 아니라 access token만 주기 때문에,
# 백엔드는 그 토큰으로 네이버/카카오 프로필 API를 직접 호출해서 검증함 —
# 그래서 여기엔 별도의 CLIENT_ID/SECRET이 필요 없음.

# Firebase Cloud Messaging — 서비스 계정 JSON을 한 줄로 붙여넣기.
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성.
# 비워두면 FCM 발송이 조용히 비활성화됨(로컬 개발용).
FIREBASE_SERVICE_ACCOUNT_JSON=''
