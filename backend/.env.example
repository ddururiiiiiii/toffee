# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toffee?schema=public"

# 이 앱(단일 인스턴스)이 DB에 동시에 열 수 있는 커넥션 최대 개수. 비우면 10.
DB_POOL_MAX="10"

# Server
PORT=3000
NODE_ENV="development"

# POST /auth/dev-login — Google/Apple/Naver/Kakao/LINE 없이 email만으로 로그인(테스트용).
# NODE_ENV != production 이고 이 값이 "true"일 때만 라우트가 존재함(그 외엔 404).
# 배포 환경에는 절대 "true"로 두지 말 것.
ENABLE_DEV_LOGIN="true"
# 테스트 로그인 입장 코드(2026-10-01) — 공개된 데모 서버엔 꼭 넣을 것(없으면 주소만 알면 운영자 계정으로도 로그인됨).
# 넣으면 로그인 화면의 "입장 코드" 칸에 같은 값을 넣어야 함. 로컬 개발은 비워 둠
DEV_LOGIN_CODE=""
# 데모 서버 가짜 데이터(src/demo/seed-cli.ts, 컨테이너 시작 때) — "true": DB가 비어 있을 때만 넣음(켜 둬도 안전),
# "reset": 켤 때마다 전부 지우고 다시 넣음(초기화 후 "true"로 되돌릴 것). 운영(production)에선 무시. 로컬은 npx prisma db seed
DEMO_SEED=""
# 결제 없이 구독되는 테스트 경로 — 실제 결제(스토어) 연결 전 개발·비공개 테스트 서버에서만 "true". 운영 서버엔 넣지 말 것
ENABLE_SANDBOX_SUBSCRIBE="true"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# 소셜 로그인 — 아래 ID들은 쉼표로 여러 개 넣을 수 있음(운영·개발 앱, iOS·웹이 서로 다른 값일 때, 2026-09-29)
# Google Sign-In — "웹" OAuth Client ID(앱의 webClientId·웹 로그인 모두 이 값이 idToken audience)
# 2026-10-02 발급(웹 클라이언트, 공개 값) — 데모 서버(Railway)에도 같은 값
GOOGLE_CLIENT_ID="887521312316-q0gnbre54fcul8j3fujuusdem4npejrc.apps.googleusercontent.com"

# Apple Sign-In — iOS 앱은 번들 ID(com.toffeechat.app, 개발용 com.toffeechat.app.dev), 웹 로그인을 붙이면 Services ID도
APPLE_CLIENT_ID=""

# LINE Login — Channel ID (id_token의 aud). 운영·개발 채널을 나누면 둘 다
LINE_CHANNEL_ID="2011830249"

# 카카오 — 앱 ID(카카오 개발자 콘솔 "앱 키" 위의 숫자 ID). 넣으면 받은 토큰이 우리 앱에서 발급된 것인지 확인함(다른 앱 토큰으로
# 로그인하는 바꿔치기 방지 — 운영에선 꼭 넣을 것). 네이버는 사용자 id가 앱마다 달라서 따로 확인 안 함.
KAKAO_APP_ID="1595119"

# PC 웹 소셜 로그인(카카오·네이버·LINE, 2026-09-29) — 회사 로그인 페이지가 돌려준 code를 서버가 교환. 앱과 **같은** 카카오 앱·네이버
# 애플리케이션·LINE 채널에 "웹" 플랫폼과 돌아올 주소(<웹 주소>/oauth/kakao 등)를 추가해서 쓸 것(따로 만들면 회원 식별값이 달라 다른 계정이 됨).
# 돌아올 주소로 허용할 우리 웹 주소(쉼표로 여러 개, 예: https://admin.toffee.app,http://localhost:8081) — 비어 있으면 웹 로그인 꺼짐
WEB_LOGIN_ORIGINS=""
KAKAO_REST_API_KEY="64b35380b034b5a9da764a7e41dc5ceb"
# 카카오 콘솔에서 "Client Secret"을 켰을 때만
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID="BYoIY2nZcrD5mdA4UhZc"
NAVER_CLIENT_SECRET=""
# 애플 웹 로그인 — Apple Developer > Identifiers > Services IDs에서 만든 ID(iOS 앱 ID를 Primary App ID로 묶기, Return URL에
# <웹 주소>/oauth/apple — 애플은 https만, localhost 불가). Keys에서 "Sign in with Apple" 키(.p8)를 만들어 키 ID와 내용을 넣음(줄바꿈은 \n).
APPLE_WEB_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_SIGNIN_KEY_ID=""
APPLE_SIGNIN_PRIVATE_KEY=""
# LINE 웹 로그인에 쓸 채널(보통 운영 채널) — 이 ID는 위 LINE_CHANNEL_ID 목록에도 있어야 함
LINE_WEB_CHANNEL_ID="2011830249"
LINE_WEB_CHANNEL_SECRET=""

# Sentry — 에러 트래킹. sentry.io에서 프로젝트(Platform: NestJS) 만들면 발급되는 DSN.
# 비어 있으면 SDK가 아무것도 전송하지 않고 조용히 꺼진 채로 동작함(로컬 개발용).
# `npm run start:prod`(node --import ./dist/instrument.js)로 띄워야 초기화됨.
SENTRY_DSN=""

# 파일 저장소(S3 호환) — 배우가 올리는 사진·음성·영상. 운영은 Cloudflare R2 예정(ops-infra-backlog.md).
# 비어 있으면 업로드/미디어 첨부 요청이 503으로 실패함(조용히 넘어가지 않음).
# R2 예: STORAGE_ENDPOINT="https://<계정ID>.r2.cloudflarestorage.com", STORAGE_REGION="auto",
#        STORAGE_FORCE_PATH_STYLE="false"
# 로컬 개발: MinIO(docker) 또는 moto_server 같은 S3 에뮬레이터를 띄우고 버킷을 만든 뒤
#        STORAGE_ENDPOINT="http://127.0.0.1:9000", STORAGE_FORCE_PATH_STYLE="true"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# Firebase Cloud Messaging — 서비스 계정 JSON을 한 줄로 붙여넣기.
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성.
# 비워두면 FCM 발송이 조용히 비활성화됨(로컬 개발용).
FIREBASE_SERVICE_ACCOUNT_JSON=''

# 인앱결제(IAP) 검증 — 아래 항목들은 FCM과 달리 비워두면 조용히 꺼지는 게 아니라
# POST /actors/:id/verify-purchase 호출 시 에러가 남(결제 검증을 절대 그냥 통과시키면
# 안 되니까 일부러 이렇게 함). 앱스토어/플레이스토어에 실제 구독 상품을 등록하기 전까진
# 채울 필요 없음 — 그 전까지는 기존 POST /actors/:id/subscribe(샌드박스, 결제 없음) 사용.

# Apple — 앱의 Bundle Identifier(App Store Connect > 앱 > 일반 > App 정보).
# APPLE_CLIENT_ID(Sign in with Apple용 Services ID)와는 다른 값이니 헷갈리지 말 것.
APPLE_BUNDLE_ID=""

# Apple — 검증 시 어느 환경의 트랜잭션까지 허용할지. "SANDBOX"가 아니면 전부 프로덕션으로 취급.
APPLE_IAP_ENVIRONMENT="SANDBOX"

# Apple — 앱의 Apple ID(숫자, App Store Connect > 앱 > 일반 > App 정보). 운영(PRODUCTION) 검증에 꼭 필요
APPLE_APP_ID=""

# 스토어 서버 알림(갱신·만료·환불) — 애플: App Store Connect > 앱 > App 정보 > "App Store 서버 알림" V2 URL을
# <API_PUBLIC_URL>/iap/apple/notifications로(별도 키 없음, 서명으로 확인). 구글: Play Console "실시간 개발자 알림"의 Pub/Sub 주제에
# 푸시 구독을 만들고 엔드포인트 <API_PUBLIC_URL>/iap/google/notifications, "인증 사용" + 아래 서비스 계정·audience.
GOOGLE_RTDN_AUDIENCE=""
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=""

# 스토어 알림을 놓쳐도 만료일이 이만큼(시간) 지난 스토어 구독은 서버가 닫음(기본 24)
IAP_EXPIRY_GRACE_HOURS="24"

# Google Play — 패키지명(예: com.toffee.app)
GOOGLE_PLAY_PACKAGE_NAME=""

# Google Play — Play Console > API 액세스에서 연결한 서비스 계정의 JSON 키를 한 줄로 붙여넣기.
# 해당 서비스 계정에 "재무 데이터 보기" 이상 권한이 있어야 구독 조회 API를 호출할 수 있음.
# 스타 미발송 환불을 서버가 대신 하려면 "주문 관리(Manage orders and subscriptions)" 권한도 필요(없으면 구글 환불 요청이 실패로 안내됨).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=''

# 법정대리인(부모) 동의 이메일 발송 — 만 14세 미만 가입자에게 필요.
# 이것도 IAP처럼 비워두면 조용히 꺼지는 게 아니라 동의 요청 시 에러가 남(미성년자 보호
# 장치를 조용히 우회시키면 안 되니까 일부러 이렇게 함).

# 이메일 발송 서비스(Resend) API 키 — https://resend.com
RESEND_API_KEY=""

# 발신 이메일 주소 — Resend에서 도메인 인증을 마친 주소여야 함
EMAIL_FROM_ADDRESS=""

# 백엔드 서버의 외부 접근 가능한 URL — 부모에게 보내는 동의 확인 이메일 링크를
# 만드는 데 씀(예: "https://api.toffee.app"). 로컬 개발 중엔 ngrok 등으로 뚫은 URL을
# 넣어야 실제로 이메일 링크가 동작함.
API_PUBLIC_URL="http://localhost:3000"
# 성인만 가입(기본 켜짐, 2026-09-29) — 나라별 성년 나이(한국 19·태국 20·일본 18 등, parental-consent/minor-age.ts) 미만은 가입 불가.
# "false"로 두면 예전 방식(미성년자는 부모 이메일 동의 후 이용)으로 돌아감
ADULTS_ONLY="true"

# 스타 메시지 하나당 팬 1명이 보낼 수 있는 답장 수(버블 방식, 잠정 3 — STATUS.md 출시 전 확정 정책). 비우면 3.
FAN_REPLIES_PER_MESSAGE="3"

# 스타 장기 미발송 알림(잠정): 마지막 메시지 후 N일 배우에게, M일 배우 + 소속사, 이후 K일마다. "false"면 끔
IDLE_REMINDER_ENABLED="true"
IDLE_REMINDER_DAYS="3"
IDLE_ESCALATE_DAYS="7"
IDLE_REPEAT_DAYS="7"
# 스타 미발송 환불(2026-09-29) — 이만큼 안 보내면 3일 전·하루 전에 배우·소속사·운영자에게 경고(환불 기준 알림)
IDLE_REFUND_DAYS="30"
# 환불 요청 기한 — 결제 기간이 끝난 뒤 이 날수까지(스타 미발송·활동 종료 공통, 예전 이름 IDLE_REFUND_REQUEST_DAYS도 읽음)
REFUND_REQUEST_DAYS="7"
# 배우 활동 종료·입대 환불 — 결제 후 이 날수 안에 활동이 끝나면 그 결제 전액 환불 요청 가능
RETIRE_REFUND_DAYS="14"

# 메시지 번역(2026-09-29) — 번역 버튼을 누른 메시지만, 메시지 × 언어마다 한 번 번역해서 저장. Anthropic 콘솔에서 발급한 API 키.
# TRANSLATION_PROVIDER: claude | fake(개발용 "[th] 원문") | off. 비워 두면 키가 있으면 claude, 없으면 개발은 fake·운영은 꺼짐.
# TRANSLATION_MODEL: 기본 claude-opus-5-5 — 품질·비용 비교는 scripts/translation-sample.mjs로
ANTHROPIC_API_KEY=""
TRANSLATION_PROVIDER=""
TRANSLATION_MODEL=""

# 정산(잠정, STATUS "출시 전 확정할 정책") — 스토어 수수료 %(애플·구글 소규모 사업자·구독 2년차 기준 15),
# 수수료 뺀 금액 중 소속사 몫 기본 %(소속사별로 운영자 화면에서 따로 정할 수 있음)
STORE_FEE_PERCENT="15"
AGENCY_REVENUE_SHARE_PERCENT="70"

# 고객센터 공개 페이지(GET /support, 스토어 "지원 URL")에 보일 문의 이메일 — 앱 EXPO_PUBLIC_SUPPORT_EMAIL과 같은 주소
SUPPORT_EMAIL=""

# 호스팅 프록시(로드밸런서) 뒤에서 실제 접속 IP를 읽을지 — 프록시 단계 수(보통 1) 또는 "true". 로컬은 비움
TRUST_PROXY=""
