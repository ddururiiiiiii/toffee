// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENCY_STAFF
  ADMIN
  ACTOR
}

enum AuthProvider {
  GOOGLE
  APPLE
  NAVER
  KAKAO
  LINE
}

enum MessageSenderType {
  ARTIST
  FAN
}

enum MessageMediaType {
  TEXT
  PHOTO
  AUDIO
  VIDEO
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum IapPlatform {
  IOS
  ANDROID
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ParentalConsentStatus {
  // 만 14세 이상이라 애초에 동의가 필요 없는 계정 (기본값)
  NOT_REQUIRED
  // 만 14세 미만인데 아직 법정대리인(부모) 동의를 못 받은 상태 — 구독/결제 불가
  PENDING
  // 법정대리인이 이메일 링크로 동의 완료
  APPROVED
}

model User {
  // email은 로그인 제공자가 달라도 같은 사람이면 계정을 하나로 합치는 데 씀
  // (예: 구글로 먼저 가입 후 나중에 카카오로 로그인해도 AuthIdentity만 추가되고 User는 그대로)
  id                    String                @id @default(uuid())
  role                  Role                  @default(USER)
  displayName           String
  email                 String?               @unique
  fcmToken              String?
  status                UserStatus            @default(ACTIVE)
  suspendedUntil        DateTime?
  bannedAt              DateTime?
  // 생년월일 미입력 상태(null)면 앱이 온보딩에서 먼저 물어봄 — 만 14세 미만 판정에만 씀
  birthDate             DateTime?
  parentalConsentStatus ParentalConsentStatus @default(NOT_REQUIRED)
  parentEmail           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  authIdentities  AuthIdentity[]
  subscriptions   Subscription[]
  fanMessages     Message[]        @relation("FanMessages")
  staffOfActors   Actor[]          @relation("ActorStaff")
  reportsFiled    Report[]         @relation("ReportsFiled")
  actorSelf       Actor?           @relation("ActorSelf")
  storyViews      StoryView[]
  parentalConsent ParentalConsent?
}

model AuthIdentity {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String
  userId     String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// 만 14세 미만 회원의 법정대리인(부모) 동의 — 이메일로 보낸 링크를 부모가 클릭하면 확정.
// userId가 unique라 재요청은 새로 만들지 않고 기존 레코드를 갱신(토큰 재발급)함.
model ParentalConsent {
  id          String    @id @default(uuid())
  userId      String    @unique
  token       String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Actor {
  // 공식 프로필(실명+공식 사진)과 대화방 프로필(닉네임+사진)을 분리 — 대화방 쪽은
  // 소속사가 메신저 프로필 바꾸듯 자유롭게 변경 가능 (Bubble/Weverse 벤치마킹).
  // 이모지는 쓰지 않고 이름+이미지만 사용.
  id                      String   @id @default(uuid())
  legalName               String
  officialProfileImageUrl String?
  chatDisplayName         String
  chatProfileImageUrl     String?
  monthlyPriceCents       Int
  verified                Boolean  @default(false)
  selfUserId              String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  selfUser         User?          @relation("ActorSelf", fields: [selfUserId], references: [id])
  staff            User[]         @relation("ActorStaff")
  subscriptions    Subscription[]
  messages         Message[]
  pairingsAsFirst  GlCp[]         @relation("PairingActorOne")
  pairingsAsSecond GlCp[]         @relation("PairingActorTwo")
  stories          Story[]
}

// 팬에게 노출되는 탐색/발견 화면 없음 — 동시구독 할인 계산에만 쓰는 내부 페어링
model GlCp {
  id              String   @id @default(uuid())
  actorOneId      String
  actorTwoId      String
  discountPercent Int      @default(10)
  createdAt       DateTime @default(now())

  actorOne Actor @relation("PairingActorOne", fields: [actorOneId], references: [id])
  actorTwo Actor @relation("PairingActorTwo", fields: [actorTwoId], references: [id])

  @@unique([actorOneId, actorTwoId])
}

model Subscription {
  // lastArtistMessageAt / lastFanReplyAt는 30일 무사용 환불 판정에 그대로 사용
  // iapPlatform/iapTransactionId/iapExpiresAt는 실제 결제(IAP) 연동 전까지는 전부 null —
  // 계약 성사 전 샌드박스 플로우에서는 startedAt/cancelledAt만으로 구독 상태를 판단함
  id                  String       @id @default(uuid())
  userId              String
  actorId             String
  startedAt           DateTime     @default(now())
  lastArtistMessageAt DateTime?
  lastFanReplyAt      DateTime?
  cancelledAt         DateTime?
  iapPlatform         IapPlatform?
  // Apple의 originalTransactionId 또는 Google의 purchaseToken — 스토어 쪽 구독 인스턴스 식별자
  iapTransactionId    String?      @unique
  iapExpiresAt        DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId])
}

model Message {
  // 아티스트 메시지는 구독자 전체에게 방송되는 한 건이라(fanUserId가 없음), 팬 이름
  // 하나를 필드로 못 박아둘 수 없음 — 대신 body에 "{{name}}" 플레이스홀더를 넣어두면
  // 조회 시점에 요청한 팬 본인의 displayName으로 치환해서 내려줌(Bubble 개인화 메시지 방식)
  id         String            @id @default(uuid())
  actorId    String
  senderType MessageSenderType
  fanUserId  String?
  mediaType  MessageMediaType  @default(TEXT)
  body       String?
  mediaUrl   String?
  createdAt  DateTime          @default(now())

  actor        Actor                @relation(fields: [actorId], references: [id], onDelete: Cascade)
  fanUser      User?                @relation("FanMessages", fields: [fanUserId], references: [id])
  translations MessageTranslation[]
  reports      Report[]
}

// 원문은 한 번만 저장, 언어별 번역본은 필요할 때 생성해서 여기 캐싱 (lazy translation)
model MessageTranslation {
  id             String   @id @default(uuid())
  messageId      String
  languageCode   String
  translatedText String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, languageCode])
}

// 인스타그램 스토리처럼 24시간 뒤 사라지는 콘텐츠 — 배우 본인만 업로드, 구독자만 열람
// 가능. mediaType은 TEXT를 쓰지 않음(DTO에서 검증) — Message와 enum을 공유하는 이유는
// 미디어 종류가 같기 때문일 뿐, 스토리는 항상 미디어가 있어야 함.
model Story {
  id        String           @id @default(uuid())
  actorId   String
  mediaType MessageMediaType
  mediaUrl  String
  createdAt DateTime         @default(now())
  expiresAt DateTime

  actor Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  views StoryView[]
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  fanUserId String
  viewedAt  DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fanUser User  @relation(fields: [fanUserId], references: [id], onDelete: Cascade)

  @@unique([storyId, fanUserId])
}

model Report {
  id           String       @id @default(uuid())
  messageId    String
  reportedById String
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("ReportsFiled", fields: [reportedById], references: [id])
}

// 팬 답장 전송 전에 대조하는 금칙어 목록 — 한국어/태국어/영어 3개 언어로 관리
model BannedWord {
  id        String   @id @default(uuid())
  term      String
  language  String
  createdAt DateTime @default(now())

  @@unique([term, language])
}
