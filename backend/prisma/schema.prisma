// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENCY_STAFF
  ADMIN
  ACTOR
}

enum AuthProvider {
  GOOGLE
  APPLE
  NAVER
  KAKAO
  LINE
}

enum MessageSenderType {
  ARTIST
  FAN
}

enum MessageMediaType {
  TEXT
  PHOTO
  AUDIO
  VIDEO
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  // email은 로그인 제공자가 달라도 같은 사람이면 계정을 하나로 합치는 데 씀
  // (예: 구글로 먼저 가입 후 나중에 카카오로 로그인해도 AuthIdentity만 추가되고 User는 그대로)
  id          String   @id @default(uuid())
  role        Role     @default(USER)
  displayName String
  email       String?  @unique
  fcmToken    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authIdentities AuthIdentity[]
  subscriptions  Subscription[]
  fanMessages    Message[]      @relation("FanMessages")
  staffOfActors  Actor[]        @relation("ActorStaff")
  reportsFiled   Report[]       @relation("ReportsFiled")
  actorSelf      Actor?         @relation("ActorSelf")
  storyViews     StoryView[]
}

model AuthIdentity {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String
  userId     String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Actor {
  // 공식 프로필(실명+공식 사진)과 대화방 프로필(닉네임+사진)을 분리 — 대화방 쪽은
  // 소속사가 메신저 프로필 바꾸듯 자유롭게 변경 가능 (Bubble/Weverse 벤치마킹).
  // 이모지는 쓰지 않고 이름+이미지만 사용.
  id                      String   @id @default(uuid())
  legalName               String
  officialProfileImageUrl String?
  chatDisplayName         String
  chatProfileImageUrl     String?
  monthlyPriceCents       Int
  verified                Boolean  @default(false)
  selfUserId              String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  selfUser         User?          @relation("ActorSelf", fields: [selfUserId], references: [id])
  staff            User[]         @relation("ActorStaff")
  subscriptions    Subscription[]
  messages         Message[]
  pairingsAsFirst  GlCp[]         @relation("PairingActorOne")
  pairingsAsSecond GlCp[]         @relation("PairingActorTwo")
  stories          Story[]
}

// 팬에게 노출되는 탐색/발견 화면 없음 — 동시구독 할인 계산에만 쓰는 내부 페어링
model GlCp {
  id              String   @id @default(uuid())
  actorOneId      String
  actorTwoId      String
  discountPercent Int      @default(10)
  createdAt       DateTime @default(now())

  actorOne Actor @relation("PairingActorOne", fields: [actorOneId], references: [id])
  actorTwo Actor @relation("PairingActorTwo", fields: [actorTwoId], references: [id])

  @@unique([actorOneId, actorTwoId])
}

model Subscription {
  // lastArtistMessageAt / lastFanReplyAt는 30일 무사용 환불 판정에 그대로 사용
  id                  String    @id @default(uuid())
  userId              String
  actorId             String
  startedAt           DateTime  @default(now())
  lastArtistMessageAt DateTime?
  lastFanReplyAt      DateTime?
  cancelledAt         DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId])
}

model Message {
  // 아티스트 메시지는 구독자 전체에게 방송되는 한 건이라(fanUserId가 없음), 팬 이름
  // 하나를 필드로 못 박아둘 수 없음 — 대신 body에 "{{name}}" 플레이스홀더를 넣어두면
  // 조회 시점에 요청한 팬 본인의 displayName으로 치환해서 내려줌(Bubble 개인화 메시지 방식)
  id         String            @id @default(uuid())
  actorId    String
  senderType MessageSenderType
  fanUserId  String?
  mediaType  MessageMediaType  @default(TEXT)
  body       String?
  mediaUrl   String?
  createdAt  DateTime          @default(now())

  actor        Actor                @relation(fields: [actorId], references: [id], onDelete: Cascade)
  fanUser      User?                @relation("FanMessages", fields: [fanUserId], references: [id])
  translations MessageTranslation[]
  reports      Report[]
}

// 원문은 한 번만 저장, 언어별 번역본은 필요할 때 생성해서 여기 캐싱 (lazy translation)
model MessageTranslation {
  id             String   @id @default(uuid())
  messageId      String
  languageCode   String
  translatedText String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, languageCode])
}

// 인스타그램 스토리처럼 24시간 뒤 사라지는 콘텐츠 — 배우 본인만 업로드, 구독자만 열람
// 가능. mediaType은 TEXT를 쓰지 않음(DTO에서 검증) — Message와 enum을 공유하는 이유는
// 미디어 종류가 같기 때문일 뿐, 스토리는 항상 미디어가 있어야 함.
model Story {
  id        String           @id @default(uuid())
  actorId   String
  mediaType MessageMediaType
  mediaUrl  String
  createdAt DateTime         @default(now())
  expiresAt DateTime

  actor Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  views StoryView[]
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  fanUserId String
  viewedAt  DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fanUser User  @relation(fields: [fanUserId], references: [id], onDelete: Cascade)

  @@unique([storyId, fanUserId])
}

model Report {
  id           String       @id @default(uuid())
  messageId    String
  reportedById String
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("ReportsFiled", fields: [reportedById], references: [id])
}
